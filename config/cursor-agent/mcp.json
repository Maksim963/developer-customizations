{
  "mcpServers": {
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "datadog": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
      "headers": {
        "DD-API-KEY": "${env:DD_API_KEY}",
        "DD-APPLICATION-KEY": "${env:DD_APP_KEY}"
      }
    },
    "chlog": {
      "command": "${userHome}/workspace/cli-clickhouse/.build/chlog",
      "args": [
        "mcp",
        "serve"
      ]
    }
  }
}
